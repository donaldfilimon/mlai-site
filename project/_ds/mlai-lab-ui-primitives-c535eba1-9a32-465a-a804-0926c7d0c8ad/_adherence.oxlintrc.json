{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/general/Accordion/**",
              "components/general/Alert/**",
              "components/general/Badge/**",
              "components/general/Button/**",
              "components/general/Card/**",
              "components/general/Dialog/**",
              "components/general/DropdownMenu/**",
              "components/general/Input/**",
              "components/general/Label/**",
              "components/general/Select/**",
              "components/general/Separator/**",
              "components/general/Skeleton/**",
              "components/general/Tabs/**",
              "components/general/Textarea/**",
              "components/general/Toaster/**",
              "components/general/Tooltip/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Geist Variable))/i]",
        "message": "Font not provided by the design system. Available: Geist Variable."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {
      "Accordion": {
        "replaces": []
      },
