{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/lab/Accordion/**",
              "components/lab/Alert/**",
              "components/lab/Badge/**",
              "components/lab/Button/**",
              "components/lab/Card/**",
              "components/lab/Dialog/**",
              "components/lab/DropdownMenu/**",
              "components/lab/Input/**",
              "components/lab/Label/**",
              "components/lab/Select/**",
              "components/lab/Separator/**",
              "components/lab/Skeleton/**",
              "components/lab/Tabs/**",
              "components/lab/Textarea/**",
              "components/lab/Toaster/**",
              "components/lab/Tooltip/**",
              "components/site/AccentGlow/**",
              "components/site/Callout/**",
              "components/site/DataTable/**",
              "components/site/DeepDive/**",
              "components/site/Eyebrow/**",
              "components/site/FAQList/**",
              "components/site/FeatureCard/**",
              "components/site/Footer/**",
              "components/site/Glossary/**",
              "components/site/HeroBench/**",
              "components/site/IndexCard/**",
              "components/site/Logo/**",
              "components/site/LogoMark/**",
              "components/site/Nav/**",
              "components/site/NextUp/**",
              "components/site/PersonaCard/**",
              "components/site/Prose/**",
              "components/site/ProvLegend/**",
              "components/site/ProvTag/**",
              "components/site/PublicationIndex/**",
              "components/site/PullQuote/**",
              "components/site/Section/**",
              "components/site/SpecList/**",
              "components/site/SplitSection/**",
              "components/site/StatBlock/**",
              "components/site/StepList/**",
              "components/site/ThroughputCard/**",
              "components/vendor/LabRuntime/**",
              "components/vendor/SiteRuntime/**",
              "ui_kits/console/**",
              "ui_kits/docs/**",
              "ui_kits/marketing/**",
              "uploads/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Geist Variable|Sora|Manrope|JetBrains Mono|Outfit|Inter))/i]",
        "message": "Font not provided by the design system. Available: Geist Variable, Sora, Manrope, JetBrains Mono, Outfit, Inter."
      },
      {
        "selector": "JSXOpeningElement[name.name='AccentGlow'] > JSXAttribute > JSXIdentifier[name!=/^(?:accent|key|ref|className|style|children)$/]",
        "message": "<AccentGlow> doesn't accept that prop. Declared props: accent."
      },
      {
        "selector": "JSXOpeningElement[name.name='AccentGlow'] > JSXAttribute[name.name='accent'] > Literal[value!=/^(?:wdbx|abi|abbey)$/]",
        "message": "<AccentGlow> accent must be one of 'wdbx' | 'abi' | 'abbey'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Callout'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|children|accent|key|ref|className|style|children)$/]",
        "message": "<Callout> doesn't accept that prop. Declared props: label, children, accent."
      },
      {
        "selector": "JSXOpeningElement[name.name='Callout'] > JSXAttribute[name.name='accent'] > Literal[value!=/^(?:wdbx|abi|abbey)$/]",
        "message": "<Callout> accent must be one of 'wdbx' | 'abi' | 'abbey'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataTable'] > JSXAttribute > JSXIdentifier[name!=/^(?:cols|rows|accent|highlightCol|key|ref|className|style|children)$/]",
        "message": "<DataTable> doesn't accept that prop. Declared props: cols, rows, accent, highlightCol."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataTable'] > JSXAttribute[name.name='accent'] > Literal[value!=/^(?:wdbx|abi|abbey)$/]",
        "message": "<DataTable> accent must be one of 'wdbx' | 'abi' | 'abbey'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DeepDive'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|accent|cols|key|ref|className|style|children)$/]",
        "message": "<DeepDive> doesn't accept that prop. Declared props: items, accent, cols."
